<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft bloom — reads as glow at small sizes -->
    <path
        android:fillAlpha="0.28"
        android:fillColor="#2DD4BF"
        android:pathData="M54,54 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0" />

    <!-- Hero orb (matches the voice mic gradient) -->
    <path android:pathData="M54,54 m-33,0 a33,33 0 1,1 66,0 a33,33 0 1,1 -66,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="84"
                android:endY="84"
                android:startX="24"
                android:startY="24"
                android:type="linear">
                <item android:color="#5EEAD4" android:offset="0" />
                <item android:color="#2DD4BF" android:offset="0.5" />
                <item android:color="#818CF8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gloss highlight -->
    <path
        android:fillAlpha="0.22"
        android:fillColor="#FFFFFF"
        android:pathData="M54,28 C41,28 30,38 28,50 C36,42 45,38 54,38 C63,38 72,42 80,50 C78,38 67,28 54,28 Z" />

    <!-- Spark — single focal mark, bold at a glance -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,43 L57.2,52.8 L67,54 L57.2,55.2 L54,65 L50.8,55.2 L41,54 L50.8,52.8 Z" />
</vector>
